# Copiar a .env.local y rellenar. Nunca subir .env.local al repositorio.

# --- GTFS estático (CRTM, portal de datos abiertos) ---
# Cercanías es opcional: vacía, se usa el GTFS de Renfe (todos los núcleos, recortado a Madrid)
# https://ssl.renfe.com/ftransit/Fichero_CER_FOMENTO/fomento_transit.zip
GTFS_URL_METRO=
GTFS_URL_METRO_LIGERO=
GTFS_URL_CERCANIAS=
GTFS_URL_EMT=
GTFS_URL_INTERURBANOS=

# --- Tiempo real ---
# EMT Madrid (MobilityLabs) — requiere registro
EMT_CLIENT_ID=
EMT_PASS_KEY=

# Feeds GTFS-RT de Cercanías (JSON de Renfe). Opcionales: vacías, se usan las URLs públicas
# https://gtfsrt.renfe.com/{trip_updates,vehicle_positions,alerts}.json
GTFSRT_CERCANIAS_TRIP_UPDATES_URL=
GTFSRT_CERCANIAS_VEHICLE_POSITIONS_URL=
GTFSRT_CERCANIAS_ALERTS_URL=

# --- Datos GTFS preprocesados en producción: GitHub Pages de este repo ---
# URL base desde la que leer los JSON preprocesados, p. ej. la de GitHub Pages donde los publica
# .github/workflows/publish-gtfs.yml. Vacía: se leen de data/gtfs/processed/.
GTFS_DATA_URL=
