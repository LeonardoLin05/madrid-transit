# Copiar a .env.local y rellenar. Nunca subir .env.local al repositorio.

# --- GTFS estático (CRTM, portal de datos abiertos) ---
GTFS_URL_METRO=
GTFS_URL_METRO_LIGERO=
GTFS_URL_CERCANIAS=
GTFS_URL_EMT=
GTFS_URL_INTERURBANOS=

# --- Tiempo real ---
# EMT Madrid (MobilityLabs) — requiere registro
EMT_CLIENT_ID=
EMT_PASS_KEY=

# Feeds GTFS-RT de Cercanías (JSON de Renfe). Opcionales: vacías, se usan las URLs públicas
# https://gtfsrt.renfe.com/{trip_updates,vehicle_positions,alerts}.json
GTFSRT_CERCANIAS_TRIP_UPDATES_URL=
GTFSRT_CERCANIAS_VEHICLE_POSITIONS_URL=
GTFSRT_CERCANIAS_ALERTS_URL=

# --- Datos GTFS preprocesados en producción (Vercel) ---
# Token del Blob store (Vercel → Storage → Blob). Solo lo usa `npm run gtfs:upload`.
BLOB_READ_WRITE_TOKEN=
# URL base pública donde están los JSON (la imprime `npm run gtfs:upload`).
# Vacía en desarrollo: se leen de data/gtfs/processed/.
GTFS_DATA_URL=
# Caché del CDN para los ficheros subidos, en segundos (opcional; 86400 por defecto).
# GTFS_CACHE_SECONDS=86400
